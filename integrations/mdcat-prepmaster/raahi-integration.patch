diff --git a/js/raahi-live.js b/js/raahi-live.js
new file mode 100644
index 0000000..a9e1da0
--- /dev/null
+++ b/js/raahi-live.js
@@ -0,0 +1,56 @@
+/*
+ * Live scholarships, admissions and internships in Pakistan from RAAHI (https://raahi-phi.vercel.app) on the home view.
+ *
+ * The block contacts raahi-phi.vercel.app only when it scrolls into view while the device is online. Nothing about
+ * your tests or account is sent. If the request fails, the plain "Open RAAHI opportunities" link stays in place.
+ * The widget follows this app's light/dark theme (the data-theme attribute on <html>).
+ */
+(function () {
+  'use strict';
+  var section = document.getElementById('raahi-live');
+  if (!section) return;
+  var RAAHI = 'https://raahi-phi.vercel.app';
+  var started = false;
+  var widget = null;
+
+  function theme() {
+    return document.documentElement.getAttribute('data-theme') === 'light' ? 'light' : 'dark';
+  }
+
+  function mount() {
+    var slot = section.querySelector('[data-raahi-slot]');
+    if (!slot || !customElements.get('raahi-opportunities')) return;
+    widget = document.createElement('raahi-opportunities');
+    widget.setAttribute('kind', 'scholarship,admission,internship');
+    widget.setAttribute('scope', 'pakistan');
+    widget.setAttribute('limit', '5');
+    widget.setAttribute('theme', theme());
+    widget.setAttribute('heading', 'Live from RAAHI');
+    slot.replaceChildren(widget);
+    new MutationObserver(function () { if (widget) widget.setAttribute('theme', theme()); })
+      .observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });
+  }
+
+  function load() {
+    if (started || !navigator.onLine) return;
+    started = true;
+    var script = document.createElement('script');
+    script.src = RAAHI + '/embed/raahi-opportunities.js';
+    script.async = true;
+    script.onload = mount;
+    script.onerror = function () { started = false; };
+    document.head.appendChild(script);
+  }
+
+  if ('IntersectionObserver' in window) {
+    new IntersectionObserver(function (entries, observer) {
+      if (entries.some(function (entry) { return entry.isIntersecting; })) {
+        observer.disconnect();
+        load();
+      }
+    }, { rootMargin: '200px' }).observe(section);
+  } else {
+    load();
+  }
+  window.addEventListener('online', load);
+})();
