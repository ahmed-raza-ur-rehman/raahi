diff --git a/raahi-live.js b/raahi-live.js
new file mode 100644
index 0000000..21961ad
--- /dev/null
+++ b/raahi-live.js
@@ -0,0 +1,49 @@
+/*
+ * Live government jobs and PSC advertisements from RAAHI (https://raahi-phi.vercel.app) on the dashboard.
+ *
+ * Privacy / offline: NeuroPrep otherwise runs entirely on this device. This block contacts raahi-phi.vercel.app
+ * only when it scrolls into view while the device is online; nothing about your study data is sent. Offline, or if
+ * the request fails, the plain "Open RAAHI opportunities" link stays in place.
+ */
+(function () {
+  'use strict';
+  var section = document.getElementById('raahi-live');
+  if (!section) return;
+  var RAAHI = 'https://raahi-phi.vercel.app';
+  var started = false;
+
+  function mount() {
+    var slot = section.querySelector('[data-raahi-slot]');
+    if (!slot || !customElements.get('raahi-opportunities')) return;
+    var widget = document.createElement('raahi-opportunities');
+    widget.setAttribute('kind', 'job');
+    widget.setAttribute('scope', 'pakistan');
+    widget.setAttribute('limit', '5');
+    widget.setAttribute('theme', 'dark');
+    widget.setAttribute('heading', 'Live from RAAHI');
+    slot.replaceChildren(widget);
+  }
+
+  function load() {
+    if (started || !navigator.onLine) return;
+    started = true;
+    var script = document.createElement('script');
+    script.src = RAAHI + '/embed/raahi-opportunities.js';
+    script.async = true;
+    script.onload = mount;
+    script.onerror = function () { started = false; };
+    document.head.appendChild(script);
+  }
+
+  if ('IntersectionObserver' in window) {
+    new IntersectionObserver(function (entries, observer) {
+      if (entries.some(function (entry) { return entry.isIntersecting; })) {
+        observer.disconnect();
+        load();
+      }
+    }, { rootMargin: '200px' }).observe(section);
+  } else {
+    load();
+  }
+  window.addEventListener('online', load);
+})();
