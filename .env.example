# ─────────────────────────────────────────────────────────────
# RAAHI — environment configuration
#
# Copy to `.env.local` and fill in what you need.
#
# Everything here is OPTIONAL. Raahi runs fully with no keys at all:
# the agents, search, OCR, translation, voice and web research all
# degrade to offline behaviour. Adding a key simply upgrades that
# one capability.
# ─────────────────────────────────────────────────────────────

# ── AI model provider (DashScope / Qwen) ──────────────────────
# Upgrades:
#   - agent answers are polished by qwen-plus
#   - OCR uses qwen-vl-max (otherwise basic image checks are used)
#   - speech-to-text and text-to-speech use the provider
# Without it: rule-based answers, on-device Web Speech, glossary
# translation. The app is fully functional either way.
DASHSCOPE_API_KEY=

# ── Live web search (all optional, used in this order) ────────
# Without any of these, web research answers from the curated
# official-source index instead of live results — it never fails
# and never blocks, it just has less fresh data.
BRAVE_SEARCH_API_KEY=
SERPER_API_KEY=
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_CX=

# How many live search calls per minute we allow ourselves.
# Protects the quota and the user's patience. Default: 12.
RAAHI_LIVE_SEARCH_BUDGET=12

# ── Data ──────────────────────────────────────────────────────
# Where the SQLite file lives. Defaults to data/raahi.db.
# Use a persistent disk in production — the database is the product.
# Tests override this automatically.
# RAAHI_DB_PATH=data/raahi.db

# ── Public URLs ───────────────────────────────────────────────
# Set this in every environment so sitemaps, canonical URLs and
# social sharing previews point at the real domain.
# NEXT_PUBLIC_SITE_URL=https://raahi.example.org
